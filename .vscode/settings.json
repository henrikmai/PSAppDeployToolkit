// PSAppDeployToolkit default settings to ensure consistent code formatting and file encoding
{
    //-------- Indentation configuration --------
    "editor.detectIndentation": true,
    "editor.formatOnPaste": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4,

    //-------- Files configuration --------
    "files.exclude": {
        ".editorconfig": true,
        ".gitattributes":true,
        ".gitignore":true,
        ".github": true,
        "**/Deploy-Application.exe":true,
        "**/Deploy-Application.exe.config":true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "COPYING.Lesser":true
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell PSADT": {
            "path": "C:\\windows\\system32\\WindowsPowershell\\v1.0\\powershell.exe",
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": [
                "-NoLogo",
                "-NoExit",
                "-ExecutionPolicy",
                "RemoteSigned",
                "Import-Module oh-my-posh;Set-Theme qwerty"
            ]
        },
        "Git Bash":null,
        "Command Prompt":null,
        "JavaScript Debug Terminal":null,
        "Azure Cloud Shell (Bash)":null
    },
    "terminal.integrated.defaultProfile.windows":"PowerShell PSADT",
    "files.autoGuessEncoding": true,
    "files.encoding": "utf8bom",
    "files.insertFinalNewline": true,

    // When enabled, will trim trailing whitespace when you save a file.
    "files.trimTrailingWhitespace": true,
    // specifies the location of the explicitly ScriptAnalyzer settings file
    "powershell.scriptAnalysis.settingsPath": "PSScriptAnalyzerSettings.psd1",
    // specifies the PowerShell coding style used in this project (https://github.com/PoshCode/PowerShellPracticeAndStyle/issues/81)
    "powershell.codeFormatting.preset": "Allman",
    "powershell.codeFormatting.alignPropertyValuePairs": false,
    "powershell.powerShellDefaultVersion": "Windows PowerShell (x64)",
    "dotnet.preferCSharpExtension": true
}
